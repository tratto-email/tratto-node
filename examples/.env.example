# Copy to examples/.env and fill in. examples/.env is gitignored — never commit a key.
# Used only by examples/smoke.ts, the manual pre-release smoke test.

# Test-mode API key (tratto_test_…) for the staging workspace.
# A live key is refused: only a test key guarantees no real recipient is touched.
TRATTO_API_KEY=

# Sender address for the smoke send. In test mode the domain does not need
# to be verified. Same variable name as the Python SDK's smoke test.
TRATTO_FROM_EMAIL=

# Optional. Defaults to https://api-staging.tratto.email
TRATTO_BASE_URL=
