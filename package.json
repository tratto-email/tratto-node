{
  "name": "@tratto/email",
  "version": "1.3.1",
  "description": "Node.js SDK for Tratto, the EU-hosted email API: transactional email, campaigns and automation flows",
  "keywords": [
    "email",
    "email-api",
    "transactional-email",
    "marketing-email",
    "email-campaigns",
    "emailmd",
    "eu",
    "gdpr",
    "tratto",
    "sdk",
    "typescript"
  ],
  "author": "Tratto <hello@tratto.email>",
  "license": "MIT",
  "homepage": "https://tratto.email",
  "repository": {
    "type": "git",
    "url": "https://github.com/tratto-email/tratto-node.git"
  },
  "bugs": {
    "url": "https://github.com/tratto-email/tratto-node/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src examples --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "express": "^5.0.0",
    "fastify": "^5.12.5",
    "tsup": "^8.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "volta": {
    "node": "24.21.0"
  }
}
